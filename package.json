{
  "name": "notebook-fighters",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @nf/web dev",
    "build": "pnpm --filter @nf/web build",
    "start": "pnpm --filter @nf/worker dev",
    "typecheck": "pnpm -r --workspace-concurrency=1 exec tsc --noEmit -p .",
    "test": "pnpm --filter @nf/sim test",
    "test:online": "pnpm --filter @nf/worker test:online",
    "worker:dev": "pnpm build && pnpm --filter @nf/worker dev",
    "deploy": "pnpm build && pnpm --filter @nf/worker deploy"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "description": "Draw it. Scrub it darker. Make it fight. A notebook-doodle fighting game.",
  "license": "MIT"
}
